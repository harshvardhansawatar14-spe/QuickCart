.env
.env.*
!.env.example

# PyCharm / IntelliJ
.idea/

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Excel temporary files
~$*.xlsx
~$*.xls
~$*.csv

# Python distribution files
build/
dist/
*.egg-info/
.eggs/

# Coverage
.coverage
.coverage.*
htmlcov/

# Test reports
.pytest_cache/
test-results/

